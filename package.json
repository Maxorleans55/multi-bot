{
  "name": "Bot-Baileys-AI",
  "version": "1.0.0",
  "description": "Multi-session WhatsApp bot using Baileys with MongoDB and Prisma",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include 'src/**/*.ts' src/index.ts",
    "dev:new": "tsx watch --include 'src/**/*.ts' src/index.ts -- --session=new --only",
    "dev:dev": "tsx watch --include 'src/**/*.ts' src/index.ts -- --session=dev --only",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:new": "node dist/index.js --",
    "start:dev": "node dist/index.js -- --session=dev --only",
    "test:toolCallFilter": "tsx --test tests/toolCallFilter.test.ts",
    "test:aiServiceStream": "tsx --test tests/aiServiceStream.test.ts",
    "test:aiToolChaining": "tsx --test tests/aiToolChaining.test.ts",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "multi-session",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.4.0",
    "@whiskeysockets/baileys": "7.0.0-rc12",
    "@tobyg74/tiktok-api-dl": "^1.3.7",
    "ai": "^7.0.66",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "link-preview-js": "^3.0.0",
    "moment": "^2.30.1",
    "nexo-aio-downloader": "github:Stazyu/nexo-aio-downloader",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "wa-sticker-formatter": "^4.4.4",
    "youtube-dl-exec": "^3.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@whiskeysockets/baileys",
    "protobufjs",
    "youtube-dl-exec"
  ],
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
