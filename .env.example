# Database Configuration
DATABASE_URL="mongodb://username:password@localhost:27017/bot_baileys?authSource=admin"

# Bot Configuration (optional)
BOT_NAME="Bot-Baileys-AI"

# Session filters (comma-separated session ids)
# Leave empty to load every saved session.
# EXCLUDE_SESSIONS: skip these when auto-loading from DB (e.g. exclude 'dev' in production Docker)
# INCLUDE_SESSIONS: only load these (overrides EXCLUDE_SESSIONS)
# EXCLUDE_SESSIONS="dev"
# INCLUDE_SESSIONS=""

# Owner Configuration (comma-separated WhatsApp numbers with @s.whatsapp.net)
OWNER_NUMBERS="628123456789@s.whatsapp.net"

# Prefix Configuration (comma-separated prefixes)
PREFIXES="!,.,#,/"

# Logger Configuration
LOG_LEVEL="silent"  # Options: trace, debug, info, warn, error, fatal, silent
NODE_ENV="production"  # Options: development, production

# AI Provider Configuration
# Options: "openai" | "openrouter" | "ollama" | "other"
AI_PROVIDER="openai"

# ─── OpenAI-Compatible API (used when AI_PROVIDER=openai) ──────────
# Bisa pakai API apa pun yang kompatible dengan OpenAI (Groq, Together,
# DeepSeek, Mistral AI, Azure OpenAI, dll).
# Cukup set BASE_URL, API_KEY, dan MODEL sesuai penyedia API Anda.
OPENAI_BASE_URL="https://api.openai.com/v1"      # Ganti dengan base URL API Anda
OPENAI_API_KEY="sk-********************************"  # API key Anda
OPENAI_MODEL="gpt-4o-mini"  # Model yang ingin digunakan

# Generic fallback (dibaca jika OPENAI_* atau OPENROUTER_* tidak di-set)
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# ─── OpenRouter AI Configuration (used when AI_PROVIDER=openrouter) ─
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="anthropic/claude-3-haiku"

# ─── Other Provider Configuration (used when AI_PROVIDER=other) ────
# Untuk API custom yang kompatible dengan OpenAI. Gunakan BASE_URL dan API_KEY
# dari penyedia API mana pun yang mendukung format OpenAI (Groq, Together,
# DeepSeek, Mistral AI, Azure OpenAI, dll).
OTHER_BASE_URL="https://api.custom-service.com/v1"   # Ganti dengan base URL API Anda
OTHER_API_KEY="sk-your-api-key-here"                   # API key Anda
OTHER_MODEL="custom-model-name"                        # Model yang ingin digunakan

# ─── Ollama Configuration (used when AI_PROVIDER=ollama) ────────────
# Example: http://localhost:11434 or http://your-ollama-host:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="glm-5.1:cloud"

# ─── Firecrawl Web Fetch Configuration ──────────────────────────────
# URL instance Firecrawl untuk web_fetch (scraping halaman web).
# Firecrawl adalah headless browser scraper yang bisa mengambil konten
# dari situs web modern (termasuk SPA/JS-heavy).
FIRECRAWL_URL="https://firecrawl.wahyuhp.my.id"

# ─── gallery-dl Sticker Tool ────────────────────────────────────────
# Install local: python -m pip install -U gallery-dl
# Windows bisa pakai Chocolatey/Scoop juga. Set GALLERY_DL_BIN kalau binary
# tidak ada di PATH.
GALLERY_DL_BIN="gallery-dl"
GALLERY_DL_TIMEOUT_MS="90000"
# Query biasa seperti "kucing" akan dimasukkan ke template ini.
GALLERY_DL_SEARCH_TEMPLATE="https://www.pinterest.com/search/pins/?q={query}"
# Optional: cookies.txt untuk situs yang butuh login.
# GALLERY_DL_COOKIES="C:\\path\\to\\cookies.txt"

# ─── Instagram / yt-dlp Cookies ──────────────────────────────────────
# Dua mode (pilih salah satu, prioritas browser mode):
#
# Mode 1: Auto-extract from browser (rekomendasi, no file needed)
#   INSTAGRAM_DL_COOKIES_BROWSER="chrome"
#   Supported: chrome, firefox, edge, opera, brave, vivaldi
#
# Mode 2: Manual cookies.txt (Netscape format)
#   Export pakai extension "Get cookies.txt LOCALLY" atau:
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt
#   lalu set:
#   INSTAGRAM_DL_COOKIES="C:\\path\\to\\cookies.txt"
#   (fallback: YTDLP_COOKIES)
INSTAGRAM_DL_COOKIES_BROWSER="chrome"
